# Speed up system boot handoffs by instantly updating D-Bus environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# ==============================================================================
# ARCH SWAY: COMPREHENSIVE AUTOMATED ENVIRONMENT
# ==============================================================================

# Core Modifier Key (Super / Windows Key)
set $mod Mod4

# Distraction-Free Visual Styles
font pango:DejaVu Sans Mono 10
floating_modifier $mod normal
default_border pixel 2
default_floating_border normal 2
hide_edge_borders none

# Hardware Input/Output Profiles
output * bg #1a1a1a solid_color

# Core System Utilities & Tools
bindsym $mod+Return exec kitty
bindsym $mod+Shift+Return exec kitty --app-id kitty-local
bindsym $mod+f exec firefox
bindsym Print exec grim -g "$(slurp)" - | wl-copy --type image/png

# EXPLICIT ANKI LAUNCH SHORTCUT (Super + Shift + A)
bindsym $mod+Shift+a exec ANKI_WEBRENDER=software QT_QPA_PLATFORM=xcb anki

# Configuration Controls
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload

# Workspace Navigation Bindings (Super + 1-5)
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

# Move Active Windows to Workspaces (Super + Shift + 1-5)
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5

# Window-to-Workspace Permanent Routing Rules
assign [app_id="kitty"] workspace 1
assign [app_id="yazi"] workspace 2
assign [app_id="firefox"] workspace 3
assign [app_id="anki"] workspace 4
assign [class="(?i)anki"] workspace 4
assign [app_id="(?i)zathura"] workspace 5

# Dynamic Layouts and Rules
workspace 3 layout toggle split
for_window [app_id="(?i)zathura"] fullscreen enable

# Automated Login Launch Sequence
exec amixer set Master unmute
exec amixer set Speaker unmute 100% 2>/dev/null
exec amixer set Headphone unmute 100% 2>/dev/null
exec amixer set PCM unmute 100% 2>/dev/null
exec kitty
exec kitty --app-id yazi -e yazi
exec firefox
exec bash -c 'sleep 1 && for f in ~/Downloads/The*; do [ -f "$f" ] && zathura "$f" & break; done'

# Fallback Target View Initializer
workspace 1

# Anki Layout and Window Handling
for_window [app_id="anki"] fullscreen disable, floating disable
for_window [class="(?i)anki"] fullscreen disable, floating disable
for_window [app_id="anki" title="(?i)add"] floating enable
for_window [app_id="anki" title="(?i)browse"] floating enable
for_window [class="(?i)anki" title="(?i)add"] floating enable
for_window [class="(?i)anki" title="(?i)browse"] floating enable

# =====================================================================
# HARDWARE VOLUME BINDINGS (F2 / F3 WITHOUT FN MODIFIER)
# =====================================================================
bindsym --locked XF86AudioLowerVolume exec amixer set Master 5%- unmute, exec amixer set Speaker unmute 2>/dev/null, exec amixer set Headphone unmute 2>/dev/null
bindsym --locked XF86AudioRaiseVolume exec amixer set Master 5%+ unmute, exec amixer set Speaker unmute 2>/dev/null, exec amixer set Headphone unmute 2>/dev/null
bindsym --locked XF86AudioMute        exec amixer set Master toggle, exec amixer set Speaker toggle 2>/dev/null, exec amixer set Headphone toggle 2>/dev/null

# =====================================================================
# LIGHTWEIGHT NATIVE STATUS BAR WITH AUTO-HIDE
# =====================================================================
bar {
    position top
    status_command ~/.config/sway/status.sh
    font pango:monospace 10
    mode hide
    hidden_state hide
    modifier Mod4
    
    colors {
        statusline #f2e7c9
        background #1a1a1a
        inactive_workspace #1a1a1a #1a1a1a #888888
        focused_workspace  #f2e7c9 #1a1a1a #f2e7c9
    }
}

# =====================================================================
# HARDWARE BRIGHTNESS BINDINGS
# =====================================================================
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set +5%

# Sway same app tab jumps
bindsym Mod4+bracketright focus right
bindsym Mod4+bracketleft focus left
bindsym Mod4+Tab focus right or surface
bindsym Mod4+Shift+Tab focus left or surface

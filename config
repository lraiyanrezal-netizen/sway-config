set $mod Mod4
font pango:DejaVu Sans Mono 10

# Sync desktop variables with systemd/D-Bus to ensure smooth application boot
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Core Visual Styles & Interface
floating_modifier $mod normal
default_border pixel 2
default_floating_border normal 2
hide_edge_borders none
output * bg #1a1a1a solid_color

# Default Window Behavior (Almost Full Screen Tab Layout)
workspace_layout tabbed

# Primary App Launchers (Consistent $mod key mappings)
bindsym $mod+Return exec kitty
bindsym $mod+Shift+Return exec kitty --app-id kitty-local
bindsym $mod+f exec firefox
bindsym $mod+y exec kitty --app-id yazi -e yazi
bindsym $mod+a exec flatpak run net.ankiweb.Anki
bindsym $mod+o exec libreoffice
bindsym $mod+Shift+c reload
bindsym $mod+Shift+q kill

# Screenshot & Screencast GIF Tools
bindsym Print exec grim -g "$(slurp)" - | wl-copy --type image/png
bindsym $mod+Shift+g exec bash /home/raiyan/Downloads/02_Areas/sway-gif-encode.sh

# Hardware Media & Audio Controls
bindsym $mod+F1 exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym $mod+F2 exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+F3 exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Hardware Screen Brightness Controls
bindsym $mod+F4 exec brightnessctl set 5%-
bindsym $mod+F5 exec brightnessctl set +5%

# Workspace Nav Maps (Workspace 5 is Handled Directly via the Eclipse Binding Below)
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+6 workspace 6
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Simplified Quick-Launch for Eclipse on Workspace 5 (Navigates & Launches Instantly)
bindsym $mod+5 workspace 5; exec _JAVA_AWT_WM_NONREPARENTING=1 eclipse

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Tab/Bracket window focus navigation adjustments (Cycles tabs cleanly)
bindsym $mod+bracketleft focus left
bindsym $mod+bracketright focus right
bindsym $mod+Tab focus right or surface
bindsym $mod+Shift+Tab focus left or surface

# Window Target Rules
assign [app_id="kitty"] workspace 1
assign [app_id="yazi"] workspace 2
assign [app_id="firefox"] workspace 3
assign [app_id="net.ankiweb.Anki"] workspace 4
assign [class="(?i)eclipse"] workspace 5

assign [app_id="org.pwmt.zathura"] workspace 9
assign [class="(?i)zathura"] workspace 9
for_window [app_id="org.pwmt.zathura"] move to workspace 9; focus
for_window [class="(?i)zathura"] move to workspace 9; focus
for_window [app_id="org.pwmt.zathura"] fullscreen enable

assign [app_id="(?i).*libreoffice.*"] workspace 10
assign [class="(?i).*libreoffice.*"] workspace 10
assign [app_id="(?i).*soffice.*"] workspace 10
assign [class="(?i).*soffice.*"] workspace 10
for_window [app_id="(?i).*libreoffice.*"] move to workspace 10; focus
for_window [class="(?i).*libreoffice.*"] move to workspace 10; focus

# Anki Layout Tuning For Submenus
for_window [app_id="net.ankiweb.Anki"] layout tabbed, fullscreen disable, floating disable, border pixel 0
for_window [app_id="net.ankiweb.Anki" title="(?i)add"] fullscreen disable, floating disable, border pixel 0
for_window [app_id="net.ankiweb.Anki" title="(?i)browse"] fullscreen disable, floating disable, border pixel 0
for_window [app_id="net.ankiweb.Anki" title="(?i)stats"] fullscreen disable, floating disable, border pixel 0

# Automated Cold Boot Seq
exec kitty
exec kitty --app-id yazi -e yazi
exec firefox
exec flatpak run net.ankiweb.Anki
workspace 1

# System Status Bar
bar {
    position top
    status_command ~/.config/sway/status.sh
    font pango:monospace 10
    colors {
        statusline #f2e7c9
        background #1a1a1a
        inactive_workspace #1a1a1a #1a1a1a #888888
        focused_workspace  #f2e7c9 #1a1a1a #f2e7c9
    }
}
